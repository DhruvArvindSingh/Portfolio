#!/usr/bin/env python3
import os
import sys
import requests
import difflib
import subprocess
from pathlib import Path
from datetime import datetime
from rich.console import Console

API_KEY = os.getenv("OPENROUTER_API_KEY")
MODEL = "moonshotai/kimi-k2"  # ✅ Correct model ID
console = Console()

# File extensions to include
INCLUDE_EXTS = {".js", ".jsx", ".ts", ".tsx", ".html", ".css", ".py"}

# Folders to ignore
IGNORE_DIRS = {"node_modules", ".git", "dist", "build", "__pycache__", "venv", ".next"}

# Files to always skip
IGNORE_FILES = {
    "next-env.d.ts",
    "next.config.js",
    "next.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "tsconfig.json",
    "package.json",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml"
}

# Max file size in KB
MAX_FILE_SIZE_KB = 200

# Max characters to send in prompt (avoid API 400 errors)
MAX_PROMPT_CHARS = 8000

# Max retries for build fixing
MAX_RETRIES = 5


def clean_code_fences(text: str) -> str:
    """Remove markdown code fences from AI output."""
    lines = text.strip().splitlines()
    if len(lines) >= 2 and lines[0].startswith("```") and lines[-1].startswith("```"):
        return "\n".join(lines[1:-1])
    return text


if not API_KEY:
    console.print("[red]Error:[/red] Please set OPENROUTER_API_KEY in your environment.")
    sys.exit(1)


def call_kimi(prompt):
    """Send prompt to Kimi K2 via OpenRouter API."""
    headers = {
        "Authorization": f"Bearer {API_KEY}",
        "HTTP-Referer": "http://localhost",
        "X-Title": "Kimi Code CLI"
    }

    # Truncate prompt if too long
    if len(prompt) > MAX_PROMPT_CHARS:
        prompt = prompt[:MAX_PROMPT_CHARS] + "\n\n[...truncated due to length...]"

    data = {
        "model": MODEL,
        "messages": [
            {
                "role": "system",
                "content": (
                    "You are a coding assistant. Edit the given code according to the user's request. "
                    "Return only the full updated file content as plain text, without any markdown code fences "
                    "or extra formatting."
                )
            },
            {"role": "user", "content": prompt}
        ]
    }

    r = requests.post(
        "https://openrouter.ai/api/v1/chat/completions",
        headers=headers,
        json=data
    )

    if r.status_code != 200:
        console.print(f"[red]API Error {r.status_code}:[/red] {r.text}")
        return None

    try:
        return r.json()["choices"][0]["message"]["content"]
    except Exception as e:
        console.print(f"[red]Error parsing API response:[/red] {e}")
        return None


def process_file(file_path, instruction):
    """Process a single file with Kimi K2."""
    if file_path.is_dir():
        return False

    if file_path.suffix.lower() not in INCLUDE_EXTS:
        return False

    if any(ignored in file_path.parts for ignored in IGNORE_DIRS):
        return False

    if file_path.name in IGNORE_FILES:
        return False

    if file_path.suffix == ".d.ts":
        return False

    if file_path.stat().st_size > MAX_FILE_SIZE_KB * 1024:
        console.print(f"[yellow]Skipping large file: {file_path}[/yellow]")
        return False

    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        original_code = f.read()

    prompt = (
        f"Here is the file `{file_path}`:\n\n"
        f"```{file_path.suffix[1:]}\n{original_code}\n```\n\n"
        f"Instruction: {instruction}"
    )

    updated_code = call_kimi(prompt)
    if not updated_code:
        console.print(f"[red]Skipping {file_path} due to API error[/red]")
        return False

    updated_code = clean_code_fences(updated_code)

    diff = difflib.unified_diff(
        original_code.splitlines(),
        updated_code.splitlines(),
        fromfile=str(file_path),
        tofile=str(file_path) + " (updated)",
        lineterm=""
    )

    console.print(f"\n[cyan]--- Diff for {file_path} ---[/cyan]")
    for line in diff:
        if line.startswith("+") and not line.startswith("+++"):
            console.print(f"[green]{line}[/green]")
        elif line.startswith("-") and not line.startswith("---"):
            console.print(f"[red]{line}[/red]")
        else:
            console.print(line)

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(updated_code)

    console.print(f"[green]Changes applied automatically to {file_path}![/green]")
    return True


def run_build():
    """Run the project build and return (success, output)."""
    try:
        if Path("yarn.lock").exists():
            cmd = ["yarn", "build"]
        elif Path("pnpm-lock.yaml").exists():
            cmd = ["pnpm", "build"]
        else:
            cmd = ["npm", "run", "build"]

        result = subprocess.run(cmd, capture_output=True, text=True)
        success = result.returncode == 0
        return success, result.stdout + "\n" + result.stderr
    except Exception as e:
        return False, str(e)


def fix_build_errors(changed_files, error_log):
    """Ask Kimi to fix build errors in changed files."""
    for file_path in changed_files:
        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
            current_code = f.read()

        prompt = (
            f"The following file `{file_path}` was modified by you. "
            f"After your changes, the project failed to build.\n\n"
            f"Build error log:\n{error_log}\n\n"
            f"Here is the current content of the file:\n```{file_path.suffix[1:]}\n"
            f"{current_code}\n```\n\n"
            "Please fix the issues so the build passes. Return only the updated file content as plain text."
        )

        updated_code = call_kimi(prompt)
        if updated_code:
            updated_code = clean_code_fences(updated_code)
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(updated_code)
            console.print(f"[green]Fixed build issues in {file_path}[/green]")


def commit_and_push():
    """Create a new branch, commit, and push changes."""
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    branch_name = f"kimi-generated-{timestamp}"
    subprocess.run(["git", "checkout", "-b", branch_name])
    subprocess.run(["git", "add", "."])
    subprocess.run(["git", "commit", "-m", "kimi-generated"])
    subprocess.run(["git", "push", "origin", branch_name])
    console.print(f"[blue]Changes pushed to branch {branch_name}[/blue]")


def main():
    if len(sys.argv) < 3:
        console.print("[yellow]Usage:[/yellow] kimi-code <repo_path> <instruction>")
        sys.exit(1)

    repo_path = Path(sys.argv[1])
    instruction = " ".join(sys.argv[2:])

    if not repo_path.exists():
        console.print(f"[red]Error:[/red] Path {repo_path} does not exist.")
        sys.exit(1)

    files_to_edit = []
    if repo_path.is_file():
        files_to_edit = [repo_path]
    else:
        for ext in INCLUDE_EXTS:
            for file in repo_path.rglob(f"*{ext}"):
                if not any(ignored in file.parts for ignored in IGNORE_DIRS) and file.name not in IGNORE_FILES:
                    files_to_edit.append(file)

    if not files_to_edit:
        console.print("[yellow]No matching files found in the given path.[/yellow]")
        sys.exit(0)

    console.print(f"[blue]Found {len(files_to_edit)} files to process...[/blue]")

    changed_files = []
    for file_path in files_to_edit:
        if process_file(file_path, instruction):
            changed_files.append(file_path)

    # Build → Fix loop
    for attempt in range(MAX_RETRIES):
        success, output = run_build()
        if success:
            console.print("[green]Build succeeded![/green]")
            commit_and_push()
            break
        else:
            console.print(f"[red]Build failed (attempt {attempt+1}/{MAX_RETRIES})[/red]")
            console.print(output)
            fix_build_errors(changed_files, output)
    else:
        console.print("[red]Max retries reached. Build still failing.[/red]")


if __name__ == "__main__":
    main()